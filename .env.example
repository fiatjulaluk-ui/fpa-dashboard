# ─────────────────────────────────────────────────────────
# FP&A Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# OPTION A (Recommended for production):
# Use a backend proxy that holds your API key securely.
# Set the URL of your proxy endpoint here:
#
# VITE_API_PROXY_URL=https://your-backend.vercel.app/api/chat
#
# OPTION B (Quick demo only — exposes key in browser!):
# Set your Anthropic API key directly. NEVER use in production.
#
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# ─────────────────────────────────────────────────────────
